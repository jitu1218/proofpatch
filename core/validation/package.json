{
  "name": "@proofpatch/validation",
  "version": "0.0.0",
  "private": true,
  "description": "ProofPatch validation, freshness ledger and security checks (Member 5).",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "build:test": "tsc -p tsconfig.test.json --noEmit false --outDir .test-build",
    "test": "npm run clean:test && npm run build:test && node --test \".test-build/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.6.0"
  }
}
